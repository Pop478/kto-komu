NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:password12345678@localhost:5432/DbName?schema=public

# REDIS
REDIS_URL=redis://localhost:6379

URL=http://localhost:5000

# JWT
JWT_SECRET=supersecret
JWT_EXPIRES=7d
ADMIN_JWT_SECRET=supersecret

# ADMIN
ADMIN_LOGIN=admin@local.dev
ADMIN_PASSWORD=admin_password

# EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# CLOUDFLARE
TURNSTILE_SECRET_KEY=TURNSTILE_SECRET_KEY

# Yandex OAuth
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://api.example.com/api/v1/auth/yandex/callback

# VK ID OAuth
VK_CLIENT_ID=
VK_REDIRECT_URI=https://app.example.com/auth/vk/callback