{
    "name": "backend",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "main": "index.js",
    "private": true,
    "scripts": {
        "dev": "nodemon",
        "build": "tsc -p tsconfig.json",
        "start:prod": "node dist/index.js",
        "start:migrate:prod": "npm run prisma:deploy && npm run start:prod",
        "prisma:format": "prisma format",
        "prisma:migrate": "prisma migrate dev",
        "prisma:generate": "prisma generate",
        "prisma:deploy": "prisma migrate deploy && prisma generate",
        "api:validate": "redocly lint src/api/openapi.yaml",
        "api:bundle": "redocly bundle src/api/frontend/openapi.yaml -o src/api/frontend/openapi.bundled.yaml",
        "api:generate": "pnpm dlx openapi-typescript-codegen --useUnionTypes --input src/api/frontend/openapi.bundled.yaml --output ../frontend/src/api --client fetch",
        "api:admin:validate": "redocly lint src/api/admin/openapi.yaml",
        "api:admin:bundle": "redocly bundle src/api/admin/openapi.yaml -o src/api/admin/openapi.bundled.yaml",
        "api:admin:generate": "pnpm dlx openapi-typescript-codegen --useUnionTypes --input src/api/admin/openapi.bundled.yaml --output ../admin/src/api --client fetch"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@redocly/cli": "^2.30.6",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.6",
        "@types/multer": "^2.1.0",
        "@types/nodemailer": "^8.0.1",
        "@types/swagger-jsdoc": "^6.0.4",
        "@types/swagger-ui-express": "^4.1.8",
        "nodemon": "^3.1.14",
        "tsx": "^4.22.0",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@openrouter/sdk": "^0.13.32",
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "@runware/sdk": "^1.6.8",
        "@types/cors": "^2.8.19",
        "@types/node": "^25.8.0",
        "ajv": "^8.20.0",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jose": "^6.2.3",
        "jsonwebtoken": "^9.0.3",
        "luxon": "^3.7.2",
        "multer": "^2.1.1",
        "nodemailer": "^9.0.1",
        "prisma": "^7.8.0",
        "redis": "^6.0.0",
        "sharp": "^0.34.5",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^13.0.2",
        "winston": "^3.19.0",
        "yamljs": "^0.3.0"
    }
}
